<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Sheets.SheetsPage"
    x:TypeArguments="SheetsPageViewModel"
    x:DataType="SheetsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="A page as a sheet"
                 Summary="Put [NavigableSheet] on a page and navigating to it opens a native bottom sheet. You choose the heights it stops at; the platform draws the handle, the drag and the close button.">
            <VerticalStackLayout Spacing="10">
                <Button Text="Medium, then full screen" Command="{Binding ShowDetentsCommand}" />
                <Button Text="Compact" Command="{Binding ShowCompactCommand}" />
                <Button Text="Full screen" Command="{Binding ShowFullScreenCommand}" />
            </VerticalStackLayout>
            <Example.Code>
                [NavigableSheet(Title = "Details",
                    AllowedDetents = [SheetDetent.Medium, "75%", SheetDetent.FullScreen])]
                public partial class DetailsSheet { … }

                // A small sheet for a quick choice, or one that covers the screen
                AllowedDetents = [SheetDetent.Compact]
                AllowedDetents = [SheetDetent.FullScreen]

                // Opened like any other page
                await _navigation.NavigateToAsync&lt;DetailsSheet&gt;();
            </Example.Code>
        </Example>

        <Example Title="Dim or blur the page behind"
                 Summary="Keeps the eye on the sheet. A dim says the page behind waits; a blur hides it while the sheet is open.">
            <VerticalStackLayout Spacing="10">
                <Button Text="Dimmed" Command="{Binding ShowDetentsCommand}" />
                <Button Text="Blurred" Command="{Binding ShowBlurredCommand}" />
            </VerticalStackLayout>
            <Example.Code>
                [NavigableSheet(Title = "Filter",
                    BackgroundPageOverlay = BackgroundPageOverlay.Blurred)]
                public partial class FilterSheet { … }

                // None, Dimmed or Blurred
            </Example.Code>
        </Example>

        <Example Title="Keep a sheet from closing"
                 Summary="A swipe down closes a sheet. When closing would lose work, the view model says no, and the sheet springs back.">
            <Button Text="Open, tick Prevent dismiss, swipe down" Command="{Binding ShowBlurredCommand}" />
            <Example.Code>
                public partial class FilterSheetViewModel : ViewModelBase
                {
                    [ObservableProperty]
                    public partial bool HasChanges { get; set; }

                    public override Task&lt;bool&gt; OnCloseRequestedAsync() =&gt;
                        Task.FromResult(!HasChanges);
                }
            </Example.Code>
        </Example>

        <Example Title="Confirm and cancel in the header"
                 Summary="An editing sheet confirms with a checkmark and cancels with an X, as page actions in the sheet's header bar, in the same place at every height. The role picks the icon; the text is what a screen reader says.">
            <Button Text="Edit notifications" Command="{Binding ShowEditSheetCommand}" />
            <Example.Code>
                [PageAction("Cancel", Role = PageActionRole.Cancel)]
                [RelayCommand]
                private Task Cancel() =&gt; _navigation.CloseAsync();

                [PageAction("Save", Role = PageActionRole.Confirm)]
                [RelayCommand]
                private Task Save() =&gt; _navigation.CloseAsync();
            </Example.Code>
        </Example>

        <Example Title="A primary action at the bottom"
                 Summary="A sheet's own action (Log in, Continue, Pay) goes in the footer. It stays at the bottom of the visible sheet and follows it as you drag.">
            <Button Text="Log in" Command="{Binding ShowLoginSheetCommand}" />
            <Example.Code>
                &lt;SpinePage …&gt;
                  &lt;ScrollView&gt; … fields … &lt;/ScrollView&gt;

                  &lt;SpinePage.Footer&gt;
                    &lt;Button Text="Log in"
                            Command="{Binding LogInCommand}"
                            Margin="20,12" /&gt;
                  &lt;/SpinePage.Footer&gt;
                &lt;/SpinePage&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
