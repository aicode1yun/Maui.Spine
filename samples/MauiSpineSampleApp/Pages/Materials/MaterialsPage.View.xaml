<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Materials.MaterialsPage"
    x:TypeArguments="MaterialsPageViewModel"
    x:DataType="MaterialsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="Blur or glass behind a panel"
                 Summary="A panel over a photo stays readable without hiding it. Material.Kind puts a blur, Liquid Glass or a tint behind a Border's content, in the Border's shape. Start from a preset, or set each value yourself."
                 OptionsCommand="{Binding ShowMaterialOptionsCommand}"
                 Code="{Binding Code}">
            <VerticalStackLayout Spacing="12">
                <Grid HeightRequest="240">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Image Source="spine_hero2.png" Aspect="AspectFill" />
                    </Border>
                    <Border Material.Kind="{Binding Kind}" Material.Intensity="{Binding Intensity}" Material.TintOpacity="{Binding TintOpacity}"
                            Material.Tint="{Binding Tint}" Material.Interactive="{Binding Interactive}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 20"
                            WidthRequest="240" HeightRequest="100" VerticalOptions="End" Margin="0,0,0,20" Padding="16">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="{Binding Caption}" FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center" />
                            <Label Text="Over the photo" FontSize="14" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Hard-edged colour, where blur and tint are easiest to tell apart. -->
                <Grid HeightRequest="120">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,*,*,*,*,*">
                            <BoxView Color="#E4572E" />
                            <BoxView Grid.Column="1" Color="#F3A712" />
                            <BoxView Grid.Column="2" Color="#29335C" />
                            <BoxView Grid.Column="3" Color="#669BBC" />
                            <BoxView Grid.Column="4" Color="#A8C686" />
                            <BoxView Grid.Column="5" Color="#7B2D26" />
                        </Grid>
                    </Border>
                    <Border Material.Kind="{Binding Kind}" Material.Intensity="{Binding Intensity}" Material.TintOpacity="{Binding TintOpacity}"
                            Material.Tint="{Binding Tint}" Material.Interactive="{Binding Interactive}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 18"
                            HeightRequest="72" Margin="20,0" Padding="16">
                        <Label Text="Over colour" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Example>

        <Example Title="Glass buttons that merge"
                 Summary="On iOS 26, glass surfaces in one MaterialContainer melt together when they come closer than its spacing, as the system's bar buttons do. Bring the two buttons together and watch them join."
                 OptionsCommand="{Binding ShowMergeOptionsCommand}">
            <Grid HeightRequest="140">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Image Source="spine_hero.png" Aspect="AspectFill" />
                </Border>
                <MaterialContainer Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="{Binding Gap}">
                        <Border Material.Kind="Glass" Material.Interactive="True" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                WidthRequest="96" HeightRequest="44">
                            <Label Text="Left" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                        </Border>
                        <Border Material.Kind="Glass" Material.Interactive="True" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                WidthRequest="96" HeightRequest="44">
                            <Label Text="Right" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                </MaterialContainer>
            </Grid>
            <Example.Code>
                &lt;MaterialContainer Spacing="20"&gt;
                  &lt;HorizontalStackLayout Spacing="8"&gt;
                    &lt;Border Material.Kind="Glass"
                            Material.Interactive="True"
                            StrokeShape="RoundRectangle 22"&gt;
                      &lt;Label Text="Left" /&gt;
                    &lt;/Border&gt;
                    &lt;Border Material.Kind="Glass" …&gt;
                      &lt;Label Text="Right" /&gt;
                    &lt;/Border&gt;
                  &lt;/HorizontalStackLayout&gt;
                &lt;/MaterialContainer&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
