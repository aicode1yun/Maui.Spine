<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Theme.ThemePage"
    x:TypeArguments="ThemePageViewModel"
    x:DataType="ThemePageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="Light, dark or the system"
                 Summary="Let the user choose. Spine remembers the choice and applies it before the first page at the next launch, so the app never flashes the wrong theme. The palette button in the header does the same on every page."
                 OptionsCommand="{Binding ShowThemeOptionsCommand}">
            <Label Text="{Binding Effective}" FontSize="15" />
            <Example.Code>
                public class SettingsViewModel(IThemeService _theme)
                {
                    public void UseDark() =&gt; _theme.Current = AppTheme.Dark;

                    // Unspecified follows the device
                    public void UseSystem() =&gt; _theme.Current = AppTheme.Unspecified;
                }
            </Example.Code>
        </Example>

        <Example Title="An accent for the whole app"
                 Summary="One colour, picked by the user, on every button, switch and slider. Spine stores it like the theme, keeps a light and a dark tone, and repaints at once."
                 OptionsCommand="{Binding ShowAccentOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding AccentName}" FontSize="15" />
                <HorizontalStackLayout Spacing="12">
                    <Button Text="Button" />
                    <Switch IsToggled="True" VerticalOptions="Center" />
                    <CheckBox IsChecked="True" VerticalOptions="Center" />
                    <ActivityIndicator IsRunning="True" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Slider Value="0.6" />
            </VerticalStackLayout>
            <Example.Code>
                // A light and a dark tone; stored, repaints at once
                _theme.Accent = new SpineAccent(
                    Color.FromArgb("#FF2D55"),
                    Color.FromArgb("#FF375F"));

                // Back to the app's Primary and PrimaryDark
                _theme.Accent = null;

                &lt;Button BackgroundColor="{DynamicResource Accent}"
                        TextColor="{DynamicResource OnAccent}" /&gt;
            </Example.Code>
        </Example>

        <Example Title="Colours that follow the theme"
                 Summary="Name a colour once and give it a light and a dark value. Spine swaps the set on every change, and everything that uses the name updates.">
            <Border StrokeThickness="1" Stroke="{DynamicResource CardOutline}" BackgroundColor="{DynamicResource CardBackground}"
                    Padding="14,12" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="A card on CardBackground" TextColor="{DynamicResource CardText}" FontAttributes="Bold" />
                    <Label Text="Text on CardText, outline on CardOutline, the bar below on Accent." TextColor="{DynamicResource CardText}" FontSize="14" />
                    <BoxView Color="{DynamicResource Accent}" HeightRequest="6" CornerRadius="3" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
            <Example.Code>
                .UseSpine(options =&gt;
                    options.Theme.UseTokens&lt;LightTokens, DarkTokens&gt;())

                &lt;!-- LightTokens.xaml; DarkTokens.xaml has the same keys --&gt;
                &lt;Color x:Key="CardBackground"&gt;#FFFFFF&lt;/Color&gt;

                &lt;!-- DynamicResource re-reads the key; StaticResource would not --&gt;
                &lt;Border BackgroundColor="{DynamicResource CardBackground}" /&gt;
            </Example.Code>
        </Example>

        <Example Title="Repaint what you draw in code"
                 Summary="A control that sets its colours in code (a Skia canvas, a chart) does not see theme bindings. Track tells it when to paint again, and forgets it when the view goes away.">
            <TokenSwatch />
            <Example.Code>
                public MyChart()
                {
                    Paint();
                    SpineTheme.Track(this, Paint);
                }

                void Paint() =&gt; _line.Color = SpineTheme.GetAccent(Application.Current!.RequestedTheme);
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
