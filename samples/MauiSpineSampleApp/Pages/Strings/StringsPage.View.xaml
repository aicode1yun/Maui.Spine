<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Strings.StringsPage"
    x:TypeArguments="StringsPageViewModel"
    x:DataType="StringsPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine, Plugin.Maui.Spine.Common">

        <Example Title="Text in the user's language"
                 Summary="Keep the app's text in one XML file per language and bind labels to its keys, with values filled in. Switch the language in the options: every label follows at once, and the choice is kept for the next launch."
                 OptionsCommand="{Binding ShowLanguageOptionsCommand}">
            <Label Text="{String Strings.Greeting, Args={Binding UserName}, Arg1={Binding Now}}" FontSize="17" />
            <Example.Code>
                &lt;!-- strings.xml, strings.sv.xml: embedded --&gt;
                &lt;strings culture="sv"&gt;
                  &lt;s key="Strings.Greeting"&gt;Hej {0}, klockan är {1:HH:mm}.&lt;/s&gt;
                &lt;/strings&gt;

                &lt;Label Text="{String Strings.Greeting,
                    Args={Binding UserName}, Arg1={Binding Now}}" /&gt;

                // Every {String} updates; stored for the next launch
                _strings.Culture = CultureInfo.GetCultureInfo("sv");
            </Example.Code>
        </Example>

        <Example Title="Plurals without if statements"
                 Summary="Give a key a form for one, for none and for the rest. Bind the count and the right sentence is picked, in every language.">
            <VerticalStackLayout Spacing="10">
                <Label Text="{String Strings.Apples, Count={Binding Apples}}" FontSize="17" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{String Strings.More}" Command="{Binding MoreCommand}" />
                    <Button Text="{String Strings.Fewer}" Command="{Binding FewerCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;s key="Strings.Apples.one"&gt;{0} apple in the basket&lt;/s&gt;
                &lt;s key="Strings.Apples.zero"&gt;The basket is empty&lt;/s&gt;
                &lt;s key="Strings.Apples.other"&gt;{0} apples in the basket&lt;/s&gt;

                &lt;Label Text="{String Strings.Apples,
                    Count={Binding Apples}}" /&gt;
            </Example.Code>
        </Example>

        <Example Title="The same text from C#"
                 Summary="View models and services read the same store. A key that is missing shows as the key itself, so a gap is easy to spot instead of a blank.">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding FromCode}" FontSize="17" />
                <Label Text="{Binding Missing}" FontSize="17" />
            </VerticalStackLayout>
            <Example.Code>
                // Inject ISpineStrings, or use SpineStrings.Current
                var apples = _strings.Get("Strings.Apples", count);
                var hello = _strings.Get("Strings.Greeting", name, now);

                // A missing key returns the key: "Strings.NoSuchKey"
                var missing = _strings["Strings.NoSuchKey"];
            </Example.Code>
        </Example>

        <Example Title="Reword Spine's own text"
                 Summary="Spine's controls read their text from the same store, under keys that start with Spine. Define one of those keys in your file to reword or translate it: here the back button's screen-reader label says Home.">
            <Label Text="{String Spine.Header.Back}" FontSize="17" />
            <Example.Code>
                &lt;!-- strings.xml: the app's value wins --&gt;
                &lt;s key="Spine.Header.Back"&gt;Home&lt;/s&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
