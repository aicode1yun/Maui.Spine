<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Menus.MenusPage"
    x:TypeArguments="MenusPageViewModel"
    x:DataType="MenusPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine, Plugin.Maui.Spine.Svg.Icons">

        <Example Title="A menu in the header"
                 Summary="Give a header action a menu instead of a command, and it opens the platform's own menu. On iOS 26 the glass button morphs into it.">
            <Label Text="The palette button at the top right is one: a titled section with a picker, and a submenu for the accent." FontSize="15" />
            <Example.Code>
                PageActions.Add(new PageAction(null, new MenuItems
                {
                    new MenuSection("Appearance") { themePicker },
                    new SubMenu("Accent", "palette.svg") { accentPicker },
                })
                {
                    Svg = "palette.svg",
                    Description = "Theme and accent",
                });
            </Example.Code>
        </Example>

        <Example Title="A button that shows its choice"
                 Summary="A pop-up button: tap it for the choices, and its text becomes the one picked. For sort orders, filters and modes.">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Sort by" FontSize="15" VerticalOptions="Center" />
                    <Button Text="Name" Glass.Style="Regular" TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            MenuButton.Items="{Binding SortMenu}" MenuButton.ShowsSelection="True" />
                </HorizontalStackLayout>
                <Label Text="{Binding Sorted}" FontSize="15" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;Button Text="Name" Glass.Style="Regular"
                        MenuButton.Items="{Binding SortMenu}"
                        MenuButton.ShowsSelection="True" /&gt;

                SortMenu =
                [
                    new MenuPicker(SortCommand)
                    {
                        new MenuAction("Name") { IsChecked = true },
                        new MenuAction("Date"),
                        new MenuAction("Size") { IsEnabled = false },
                    },
                ];
            </Example.Code>
        </Example>

        <Example Title="Sections, submenus and toggles"
                 Summary="One menu holds a lot, in order: sections with a heading, a submenu, toggles that keep the menu open while you tick them, and a destructive row in red.">
            <VerticalStackLayout Spacing="10">
                <ImageButton SvgImageSource.Svg="more.svg" SvgImageSource.Padding="10" Glass.Style="Regular"
                             WidthRequest="44" HeightRequest="44" HorizontalOptions="Start"
                             MenuButton.Items="{Binding MoreMenu}" SemanticProperties.Description="More" />
                <Label Text="{Binding Summary}" FontSize="15" />
            </VerticalStackLayout>
            <Example.Code>
                &lt;ImageButton SvgImageSource.Svg="more.svg"
                             MenuButton.Items="{Binding MoreMenu}" /&gt;

                MoreMenu =
                [
                    new MenuSection("Filter:") { filterPicker },
                    new MenuSection
                    {
                        new SubMenu("Media types", "image.svg")
                        {
                            new MenuAction("Photos", "cam.svg")
                                { IsChecked = true, KeepsMenuOpen = true },
                            new MenuAction("Videos", "play.svg")
                                { KeepsMenuOpen = true },
                        },
                        new MenuAction("Reset", "refresh.svg", ResetCommand)
                            { IsDestructive = true },
                    },
                ];
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
