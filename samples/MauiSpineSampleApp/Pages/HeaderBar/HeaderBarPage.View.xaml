<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.HeaderBar.HeaderBarPage"
    x:TypeArguments="HeaderBarPageViewModel"
    x:DataType="HeaderBarPageViewModel">

    <!-- The list fills the page from the top: under a normal layout Spine insets it so the photo
         starts below the bar, under Overlay the photo starts behind the status bar and the bar. -->
    <CollectionView ItemsSource="{Binding Rows}" SafeArea.ScrollInset="Bottom">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="0">
                <Image Source="spine_hero2.png" Aspect="AspectFill" HeightRequest="260" />

                <!-- Only shown while the page has a large title; Spine measures it to fade the bar's title in. -->
                <HeaderBarLargeTitle IsVisible="{Binding LargeTitle}" Margin="16,8,16,0" />

                <VerticalStackLayout Padding="20,8,20,20" Spacing="12">
                    <ExampleCodeSwitch />
                    <PackageChips Packages="Plugin.Maui.Spine" />

                    <Example Title="Header bar"
                             Summary="Five settings shape the bar at the top of a page: where the content starts, a large title, what shows behind the bar, and the colours of its text and of the status bar. Try a combination and scroll the rows under the bar."
                             OptionsCommand="{Binding ShowOptionsCommand}"
                             Code="{Binding Code}"
                             Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="4">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="ChoiceGroup">
                                        <Label FontSize="15">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Name}" />
                                                    <Span Text=": " />
                                                    <Span Text="{Binding Selected.Label}" FontAttributes="Bold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding Resolved}" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Example>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="Swatch">
                <Border Margin="20,6" Padding="16,14" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{Binding Colour}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding Text}" TextColor="White" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</SpinePage>
