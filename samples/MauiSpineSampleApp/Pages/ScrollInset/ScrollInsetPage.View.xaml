<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.ScrollInset.ScrollInsetPage"
    x:TypeArguments="ScrollInsetPageViewModel"
    x:DataType="ScrollInsetPageViewModel">

    <!-- The list is the demo: it draws behind the home indicator / gesture bar, and its own
         SafeArea.ScrollInset (bound, so the options can turn it off) wins over the app default. -->
    <Grid>
        <CollectionView ItemsSource="{Binding Rows}" SafeArea.ScrollInset="{Binding Edges}">
            <CollectionView.Header>
                <VerticalStackLayout Margin="{x:Static HeaderBarConstants.PagePadding}" Padding="0,8,0,20" Spacing="12">
                    <ExampleCodeSwitch />
                    <PackageChips Packages="Plugin.Maui.Spine" />

                    <Example Title="Scroll clear of the home indicator"
                             Summary="The list runs to the bottom edge of the screen, behind the home indicator, yet its last row can still scroll up clear of it. Turn the inset off in the options and scroll to the end: the bar's area, marked red, covers the last row."
                             OptionsCommand="{Binding ShowInsetOptionsCommand}"
                             Margin="0,12,0,0">
                        <Label Text="{Binding Status}" FontSize="15" />
                        <Example.Code>
                            // Draw behind the home indicator, and let the
                            // list scroll its last row clear of it
                            [NavigableRegion(Title = "Inbox",
                                SafeAreaEdges = SafeAreaEdges.Top
                                    | SafeAreaEdges.Left | SafeAreaEdges.Right,
                                ScrollInset = SafeAreaEdges.Bottom)]

                            // Or on the list itself; a ScrollView works too
                            &lt;CollectionView SafeArea.ScrollInset="Bottom" /&gt;

                            // Or for every page, in UseSpine
                            options.RegionDefaults.SafeAreaEdges =
                                SafeAreaEdges.Top | SafeAreaEdges.Left
                                    | SafeAreaEdges.Right;
                            options.RegionDefaults.ScrollInset =
                                SafeAreaEdges.Bottom;
                        </Example.Code>
                    </Example>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Margin="{x:Static HeaderBarConstants.PagePadding}" Padding="0,14" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding .}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" TextColor="Gray" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Marks the home indicator's area so the effect is visible on a simulator too. -->
        <BoxView VerticalOptions="End"
                 HeightRequest="{Binding BottomInset}"
                 Color="Red"
                 Opacity="0.35"
                 InputTransparent="True" />
    </Grid>

</SpinePage>
