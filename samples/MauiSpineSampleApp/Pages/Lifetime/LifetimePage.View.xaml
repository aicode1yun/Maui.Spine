<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Lifetime.LifetimePage"
    x:TypeArguments="LifetimePageViewModel"
    x:DataType="LifetimePageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="Refresh only while the page shows"
                 Summary="Poll runs your work at once and then on an interval while the page is on screen. It pauses in the background and when the user leaves, and runs again as soon as they are back. No timer to start or stop.">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Ticks, StringFormat='Ticks: {0}'}" FontSize="28" Text.FontFeatures="TabularFigures" />
                <Label Text="{Binding LastTick, StringFormat='Last tick at {0}'}" TextColor="Gray" />
                <Label Text="Send the app to the background and come back: the count stops meanwhile and ticks at once on return."
                       FontSize="13" TextColor="Gray" Margin="0,6,0,0" />
            </VerticalStackLayout>
            <Example.Code>
                public ScoresViewModel(IScoreService scores)
                {
                    Poll(TimeSpan.FromSeconds(30), async ct =&gt;
                        Scores = await scores.GetAsync(ct));
                }
            </Example.Code>
        </Example>

        <Example Title="Cancel a load when the user leaves"
                 Summary="PageLifetime is a cancellation token that ends when the page goes away. Pass it to what the page starts, and a slow load stops instead of finishing for nobody.">
            <VerticalStackLayout Spacing="6">
                <Button Text="Start a 10-second download" Command="{Binding StartDownloadCommand}" HorizontalOptions="Start" />
                <Label Text="{Binding Download}" />
                <Label Text="Go back while it runs: it is cancelled with the page." FontSize="13" TextColor="Gray" />
            </VerticalStackLayout>
            <Example.Code>
                [RelayCommand]
                private async Task Load() =&gt;
                    Items = await _api.GetItemsAsync(PageLifetime);
            </Example.Code>
        </Example>

        <Example Title="Listen only while the page shows"
                 Summary="WhileVisible subscribes to an event when the page appears and unsubscribes when it goes, so a page in the back stack does no work and nothing leaks. The handler runs on the UI thread.">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Network, StringFormat='Network: {0}'}" />
                <Label Text="Toggle airplane mode: the label follows while this page shows." FontSize="13" TextColor="Gray" />
            </VerticalStackLayout>
            <Example.Code>
                WhileVisible&lt;ConnectivityChangedEventArgs&gt;(
                    h =&gt; Connectivity.Current.ConnectivityChanged += h,
                    h =&gt; Connectivity.Current.ConnectivityChanged -= h,
                    (_, e) =&gt; Network = e.NetworkAccess.ToString());
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
