<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Dates.DatesPage"
    x:TypeArguments="DatesPageViewModel"
    x:DataType="DatesPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Calendar">

        <Example Title="Pick a date"
                 Summary="A month calendar in plain MAUI views. Swipe to change month, tap the title to jump to another month or year; names and colours follow the app's language and theme."
                 OptionsCommand="{Binding ShowCalendarOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border StrokeThickness="1" Stroke="{DynamicResource CardOutline}" BackgroundColor="{DynamicResource CardBackground}"
                        Padding="8,10" StrokeShape="RoundRectangle 16">
                    <Calendar SelectedDate="{Binding SelectedDate}"
                              DisplayDate="{Binding DisplayDate}"
                              ShowWeekNumbers="{Binding ShowWeekNumbers}"
                              ShowTrailingDays="{Binding ShowTrailingDays}"
                              ShowSelectedDate="{Binding ShowSelectedDate}"
                              FirstDayOfWeek="{Binding FirstDayOfWeek}"
                              Culture="{Binding Culture}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding SelectedText}" FontSize="14" />
                        <Label Text="{Binding DisplayText}" FontSize="14" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Today" Command="{Binding GoToTodayCommand}" />
                    <Button Grid.Column="2" Text="Clear" Command="{Binding ClearSelectionCommand}" />
                </Grid>
            </VerticalStackLayout>
            <Example.Code>
                &lt;Calendar SelectedDate="{Binding Date}"
                          DisplayDate="{Binding Month}"
                          ShowWeekNumbers="True"
                          FirstDayOfWeek="Monday" /&gt;

                // No selection: DateTime.MinValue
                // DisplayDate becomes the 1st of each month shown

                // Names follow SpineStrings.Culture, or pin one
                Culture="{Binding Culture}"
            </Example.Code>
        </Example>

        <Example Title="Mark the days that have something"
                 Summary="The calendar asks your service which days to mark, a month at a time and the months either side ahead of a swipe. The events themselves stay in your app."
                 OptionsCommand="{Binding ShowMarkOptionsCommand}">
            <VerticalStackLayout Spacing="10">
                <Border StrokeThickness="1" Stroke="{DynamicResource CardOutline}" BackgroundColor="{DynamicResource CardBackground}"
                        Padding="8,10" StrokeShape="RoundRectangle 16">
                    <Calendar FirstDayOfWeek="{Binding FirstDayOfWeek}"
                              Culture="{Binding Culture}"
                              MarkSource="{Binding MarkSource}"
                              StyleOptions="{Binding CalendarStyle}" />
                </Border>
                <Label Text="{Binding MarkQueryText}" FontSize="14" />
                <Button Text="Change the service's data" Command="{Binding ChangeEventsCommand}" />
            </VerticalStackLayout>
            <Example.Code>
                // Your service, asked for each month page
                class EventMarks(IEventApi api) : CalendarMarkSource
                {
                    public override async
                        ValueTask&lt;IReadOnlyCollection&lt;DateOnly&gt;&gt;
                        GetMarkedDatesAsync(DateOnly first,
                            DateOnly last, CancellationToken ct)
                        =&gt; await api.DaysWithEventsAsync(first, last, ct);
                }

                // New data: the calendar asks again
                marks.NotifyChanged();

                // Or a set of days, from a view model
                public CalendarMarks Marks { get; } = new();
                Marks.Set(days); // Add, Remove, Clear

                &lt;Calendar MarkSource="{Binding Marks}"&gt;
                  &lt;Calendar.StyleOptions&gt;
                    &lt;CalendarStyleOptions MarkStyle="Dot" /&gt;
                  &lt;/Calendar.StyleOptions&gt;
                &lt;/Calendar&gt;

                &lt;!-- For every calendar: in App.xaml --&gt;
                &lt;CalendarStyleOptions
                    x:Key="DefaultCalendarStyleOptions"
                    MarkStyle="Dot" /&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
