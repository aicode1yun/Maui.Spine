<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Shimmer.ShimmerPage"
    x:TypeArguments="ShimmerPageViewModel"
    x:DataType="ShimmerPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine.Controls.Shimmer">

        <Example Title="A placeholder that shows it is loading"
                 Summary="Lay out empty blocks where the content will go and a wave sweeps over them. It follows the theme, and stays still when the user has Reduce Motion on."
                 OptionsCommand="{Binding ShowShimmerOptionsCommand}">
            <Border Padding="14" StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource CardOutline}">
                <Shimmer IsLoading="{Binding IsWaveRunning}" WaveWidth="{Binding WaveWidth}" WaveOpacity="{Binding WaveOpacity}">
                    <Grid ColumnDefinitions="48,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <Border Grid.RowSpan="2" StrokeThickness="0" WidthRequest="48" HeightRequest="48" StrokeShape="Ellipse" />
                        <Border Grid.Column="1" StrokeThickness="0" HeightRequest="16" WidthRequest="160" HorizontalOptions="Start"
                                VerticalOptions="End" StrokeShape="RoundRectangle 4" />
                        <Border Grid.Column="1" Grid.Row="1" StrokeThickness="0" HeightRequest="12" WidthRequest="100" HorizontalOptions="Start"
                                VerticalOptions="Start" StrokeShape="RoundRectangle 4" />
                        <Border Grid.Row="2" Grid.ColumnSpan="2" StrokeThickness="0" HeightRequest="72" Margin="0,4,0,0"
                                StrokeShape="RoundRectangle 8" />
                    </Grid>
                </Shimmer>
            </Border>
            <Example.Code>
                &lt;Shimmer IsLoading="{Binding IsLoading}"&gt;
                    &lt;Grid ColumnDefinitions="48,*" ColumnSpacing="12"&gt;
                        &lt;!-- Empty views are the blocks --&gt;
                        &lt;Border StrokeShape="Ellipse"
                                HeightRequest="48" /&gt;
                        &lt;Border Grid.Column="1" HeightRequest="16"
                                StrokeShape="RoundRectangle 4" /&gt;
                    &lt;/Grid&gt;
                &lt;/Shimmer&gt;

                &lt;!-- The look for the whole app, in App.xaml --&gt;
                &lt;ShimmerStyleOptions
                    x:Key="DefaultShimmerStyleOptions"
                    WaveWidth="0.3" WaveOpacity="0.25"
                    WaveDuration="0:0:1.4" /&gt;
            </Example.Code>
        </Example>

        <Example Title="The real layout as its own skeleton"
                 Summary="No second layout to keep in step: while the data loads, the page's own labels are drawn as bars and its images as blocks, in the places the content will take."
                 OptionsCommand="{Binding ShowSkeletonOptionsCommand}">
            <VerticalStackLayout Spacing="12">
                <Button Text="Reload" Command="{Binding ReloadCommand}" HorizontalOptions="Start" />
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBackground}" Stroke="{DynamicResource CardOutline}">
                    <VerticalStackLayout Padding="14" Spacing="10" Skeleton.IsActive="{Binding IsLoading}">
                        <Image Source="{Binding Photo}" HeightRequest="140" Aspect="AspectFill" />
                        <Label Text="{Binding PlaceName}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource CardText}" />
                        <Label Text="{Binding Bio}" FontSize="14" MaxLines="3" LineBreakMode="TailTruncation"
                               TextColor="{DynamicResource CardText}" Skeleton.Lines="3" />
                        <Button Text="Plan a trip" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <Example.Code>
                &lt;VerticalStackLayout
                    Skeleton.IsActive="{Binding IsLoading}"&gt;
                    &lt;Image Source="{Binding Photo}"
                           HeightRequest="140" /&gt;
                    &lt;Label Text="{Binding Name}" FontSize="20" /&gt;
                    &lt;!-- Three bars while there is no text --&gt;
                    &lt;Label Text="{Binding Bio}" MaxLines="3"
                           Skeleton.Lines="3" /&gt;
                &lt;/VerticalStackLayout&gt;
            </Example.Code>
        </Example>

        <Example Title="A list that does not jump"
                 Summary="Give the list a few empty rows while it loads and the skeleton draws them in the row template, so the page has its final height before the data arrives. A TaskState with a placeholder does this for you: see Loading states."
                 OptionsCommand="{Binding ShowSkeletonOptionsCommand}">
            <VerticalStackLayout Spacing="12">
                <Button Text="Reload" Command="{Binding ReloadCommand}" HorizontalOptions="Start" />
                <VerticalStackLayout Spacing="12"
                                     Skeleton.IsActive="{Binding IsLoading}"
                                     BindableLayout.ItemsSource="{Binding People}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="PersonRow">
                            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                <Border StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="44" HeightRequest="44">
                                    <Image Source="{Binding Photo}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding Role}" FontSize="13" Opacity="0.7" Skeleton.Width="0.4" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                // Four empty rows until the real ones arrive
                People = [.. Enumerable.Repeat(
                    new Person("", "", null), 4)];
                IsLoading = true;
                People = await _people.GetAsync(PageLifetime);
                IsLoading = false;

                &lt;VerticalStackLayout
                    Skeleton.IsActive="{Binding IsLoading}"
                    BindableLayout.ItemsSource="{Binding People}"&gt;
                    …
                        &lt;!-- A bar 40 % of the label's width --&gt;
                        &lt;Label Text="{Binding Role}"
                               Skeleton.Width="0.4" /&gt;
                    …
                &lt;/VerticalStackLayout&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
