<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Typography.TypographyPage"
    x:TypeArguments="TypographyPageViewModel"
    x:DataType="TypographyPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="Numbers that hold still"
                 Summary="In most fonts a 1 is narrower than an 8, so a ticking clock or a score shakes as it changes. Tabular figures give every digit the same width, in the font you already use.">
            <VerticalStackLayout Spacing="6">
                <Label Text="Default" FontSize="13" TextColor="Gray" />
                <Border StrokeThickness="0" BackgroundColor="#22808080" Padding="12,8" StrokeShape="RoundRectangle 10">
                    <Label Text="{Binding Clock}" FontSize="34" FontFamily="BrandonGrotesqueLight" HorizontalOptions="Start" />
                </Border>
                <Label Text="TabularFigures" FontSize="13" TextColor="Gray" Margin="0,8,0,0" />
                <Border StrokeThickness="0" BackgroundColor="#22808080" Padding="12,8" StrokeShape="RoundRectangle 10">
                    <Label Text="{Binding Clock}" FontSize="34" FontFamily="BrandonGrotesqueLight" HorizontalOptions="Start" Text.FontFeatures="TabularFigures" />
                </Border>
            </VerticalStackLayout>
            <Example.Code>
                &lt;Label Text="{Binding Clock}"
                       Text.FontFeatures="TabularFigures" /&gt;

                &lt;!-- Several at once, or an OpenType tag --&gt;
                &lt;Label Text.FontFeatures="TabularFigures, SlashedZero" /&gt;
                &lt;Label Text.FontFeatures="ss07" /&gt;
            </Example.Code>
        </Example>

        <Example Title="Capitals in the middle of a badge"
                 Summary="Many fonts leave more room above capitals than below, so initials in a circle or a LIVE pill sit too low. Trimming to the cap height centres the letters themselves. The line marks the centre; each pair is default, then trimmed.">
            <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="16">
                    <Border StrokeThickness="0" BackgroundColor="{DynamicResource Accent}" WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 36">
                        <Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OnAccent}" Opacity="0.5" VerticalOptions="Center" />
                            <Label Text="AB" TextColor="{DynamicResource OnAccent}" FontSize="36" FontFamily="JosefinSansBold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" BackgroundColor="{DynamicResource Accent}" WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 36">
                        <Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OnAccent}" Opacity="0.5" VerticalOptions="Center" />
                            <Label Text="AB" TextColor="{DynamicResource OnAccent}" FontSize="36" FontFamily="JosefinSansBold" HorizontalOptions="Center" VerticalOptions="Center" Text.TrimToCapHeight="True" />
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="16">
                    <Border StrokeThickness="0" BackgroundColor="{DynamicResource Accent}" Padding="16,8" StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                        <Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OnAccent}" Opacity="0.5" VerticalOptions="Center" />
                            <Label Text="LIVE" TextColor="{DynamicResource OnAccent}" FontSize="22" FontFamily="JosefinSansBold" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" BackgroundColor="{DynamicResource Accent}" Padding="16,8" StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                        <Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource OnAccent}" Opacity="0.5" VerticalOptions="Center" />
                            <Label Text="LIVE" TextColor="{DynamicResource OnAccent}" FontSize="22" FontFamily="JosefinSansBold" Text.TrimToCapHeight="True" />
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;Border StrokeShape="Ellipse"
                        WidthRequest="72" HeightRequest="72"&gt;
                    &lt;Label Text="AB"
                           FontFamily="JosefinSansBold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Text.TrimToCapHeight="True" /&gt;
                &lt;/Border&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
