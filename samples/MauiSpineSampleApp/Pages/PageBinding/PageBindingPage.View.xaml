<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.PageBinding.PageBindingPage"
    x:TypeArguments="PageBindingPageViewModel"
    x:DataType="PageBindingPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine">

        <Example Title="Reach the page from inside a row"
                 Summary="In an item template the binding context is the row, so the page's commands and settings are out of reach. PageCommand and PageBinding find the page's view model, with no RelativeSource or x:Reference."
                 OptionsCommand="{Binding ShowOptionsCommand}">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Picked}" FontAttributes="Bold" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Fruits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="Fruit">
                            <Border StrokeThickness="0" Padding="12" BackgroundColor="#22808080" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding PricePerKg, StringFormat='{0:0} SEK/kg'}" FontSize="13" TextColor="Gray"
                                               IsVisible="{PageBinding ShowPrices}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Pick" Command="{PageCommand Pick}" CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Example.Code>
                &lt;DataTemplate x:DataType="Fruit"&gt;
                    &lt;HorizontalStackLayout&gt;
                        &lt;Label Text="{Binding Name}" /&gt;
                        &lt;Label Text="{Binding PricePerKg}"
                               IsVisible="{PageBinding ShowPrices}" /&gt;
                        &lt;Button Text="Pick"
                                Command="{PageCommand Pick}"
                                CommandParameter="{Binding .}" /&gt;
                    &lt;/HorizontalStackLayout&gt;
                &lt;/DataTemplate&gt;

                // Binding reads the row; PageBinding and
                // PageCommand read the page's view model
                [ObservableProperty]
                public partial bool ShowPrices { get; set; }

                [RelayCommand]
                private void Pick(Fruit fruit) =&gt; Picked = fruit;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
