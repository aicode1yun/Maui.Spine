<SpinePage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiSpineSampleApp.Pages.Glass.GlassPage"
    x:TypeArguments="GlassPageViewModel"
    x:DataType="GlassPageViewModel">

    <SampleLayout Packages="Plugin.Maui.Spine, Plugin.Maui.Spine.Svg">

        <!-- Glass refracts what is behind it, so both demos sit on a photo. -->
        <Example Title="Buttons that float on glass"
                 Summary="Set Glass.Style on an ordinary Button or ImageButton and iOS 26 draws it as Liquid Glass, letting the photo behind show through. Older iOS, Android and Windows draw the same markup as a normal button.">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" HeightRequest="240">
                <Grid>
                    <Image Source="mountain.png" Aspect="AspectFill" />
                    <ImageButton Style="{StaticResource SvgImageButtonStyle}" SvgImageSource.Svg="chevronleft.svg" SvgImageSource.Padding="10"
                                 Glass.Style="Regular" WidthRequest="44" HeightRequest="44"
                                 HorizontalOptions="Start" VerticalOptions="Start" Margin="12" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                        <ImageButton Style="{StaticResource SvgImageButtonStyle}" SvgImageSource.Svg="share.svg" SvgImageSource.Padding="10"
                                     Glass.Style="Regular" WidthRequest="44" HeightRequest="44" />
                        <ImageButton Style="{StaticResource SvgImageButtonStyle}" SvgImageSource.Svg="heart.svg" SvgImageSource.Padding="10"
                                     Glass.Style="Regular" WidthRequest="44" HeightRequest="44" />
                    </HorizontalStackLayout>
                    <Button Text="Directions" Glass.Style="Prominent" HorizontalOptions="Center" VerticalOptions="End" Margin="12,16" />
                </Grid>
            </Border>
            <Example.Code>
                &lt;Button Text="Directions" Glass.Style="Prominent"
                        BackgroundColor="{DynamicResource Accent}" /&gt;

                &lt;ImageButton SvgImageSource.Svg="share.svg"
                             SvgImageSource.Padding="10"
                             Glass.Style="Regular"
                             WidthRequest="44" HeightRequest="44" /&gt;
            </Example.Code>
        </Example>

        <Example Title="A style for each job"
                 Summary="Regular for most floating controls, Prominent for the one action a screen leads with, Clear over busy photos and maps. Transient shows no glass until it is pressed."
                 OptionsCommand="{Binding ShowStyleOptionsCommand}">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" HeightRequest="220">
                <Grid>
                    <Image Source="mountain.png" Aspect="AspectFill" IsVisible="{Binding ShowPhoto}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12"
                          Padding="16" VerticalOptions="Center">
                        <Button Text="Regular" Glass.Style="Regular" IsEnabled="{Binding ButtonsEnabled}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Column="1" Text="Prominent" Glass.Style="Prominent" IsEnabled="{Binding ButtonsEnabled}" />
                        <Button Grid.Row="1" Text="Clear" Glass.Style="Clear" IsEnabled="{Binding ButtonsEnabled}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Prominent clear" Glass.Style="ProminentClear" IsEnabled="{Binding ButtonsEnabled}" />
                        <Button Grid.Row="2" Grid.ColumnSpan="2" Text="Transient" Glass.Style="Transient" IsEnabled="{Binding ButtonsEnabled}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" HorizontalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>
            <Example.Code>
                // Regular         frosted, most floating controls
                // Prominent       tinted with BackgroundColor
                // Clear           nearly transparent, over photos
                // ProminentClear  tinted and nearly transparent
                // Transient       glass only while pressed

                &lt;!-- A label colour: white is for filled buttons --&gt;
                &lt;Button Text="Regular" Glass.Style="Regular"
                        TextColor="{AppThemeBinding Light=Black,
                                                    Dark=White}" /&gt;
            </Example.Code>
        </Example>

    </SampleLayout>

</SpinePage>
