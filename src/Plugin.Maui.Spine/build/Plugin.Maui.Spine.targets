<Project>
	<!--
		UseSpine() registers every Spine package the app references, without scanning assemblies at
		startup. A package that needs the MauiAppBuilder declares itself in its buildTransitive props:

		  <SpineModule Include="Plugin.Maui.Spine.Controls.AnimatedLabel"
		               Register="Plugin.Maui.Spine.Controls.AnimatedLabelExtensions.UseAnimatedLabel" />

		Include is the package's assembly name; Register is a static method taking the builder (further
		parameters must be optional). This target writes one C# file into the app with a
		[ModuleInitializer] that hands each Register method to SpineModules, and UseSpine() runs them.

		Only modules whose assembly is among the resolved references are written, so a declaration
		imported for a package the app does not compile against is ignored. Only an app is given the
		file (a library that references Spine would otherwise register every module a second time);
		an Android app counts although the Android SDK sets its OutputType to Library;
		set SpineGenerateModuleRegistrations to false to turn it off.

		Consumed through a ProjectReference this file has to be imported explicitly, together with the
		packages' build\*.props; samples\Directory.Build.targets does both for this repo.
	-->

	<PropertyGroup>
		<SpineGenerateModuleRegistrations Condition="'$(SpineGenerateModuleRegistrations)' == ''">true</SpineGenerateModuleRegistrations>
	</PropertyGroup>

	<Target Name="_SpineGenerateModuleRegistrations"
			BeforeTargets="CoreCompile"
			Condition="'$(SpineGenerateModuleRegistrations)' == 'true' And '$(Language)' == 'C#' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(AndroidApplication)' == 'true')">

		<ItemGroup>
			<_SpineReferencedAssembly Include="@(ReferencePath->'%(Filename)')" />
			<_SpineUnreferencedModule Include="@(SpineModule)" Exclude="@(_SpineReferencedAssembly)" />
			<_SpineModule Include="@(SpineModule)" Exclude="@(_SpineUnreferencedModule)" />
		</ItemGroup>

		<PropertyGroup>
			<_SpineCoreReferenced Condition="'%(_SpineReferencedAssembly.Identity)' == 'Plugin.Maui.Spine'">true</_SpineCoreReferenced>
			<_SpineModulesFile>$(IntermediateOutputPath)SpineModules.g.cs</_SpineModulesFile>
			<!-- MSBuild trims item specs; escaped spaces survive. -->
			<_SpineIndent>%20%20%20%20</_SpineIndent>
		</PropertyGroup>

		<RemoveDuplicates Inputs="@(_SpineModule->'%(Register)')" Condition="'$(_SpineCoreReferenced)' == 'true'">
			<Output TaskParameter="Filtered" ItemName="_SpineModuleRegister" />
		</RemoveDuplicates>

		<ItemGroup Condition="'@(_SpineModuleRegister)' != ''">
			<_SpineModulesLine Include="// &lt;auto-generated&gt;" />
			<_SpineModulesLine Include="//   Written by Plugin.Maui.Spine.targets from the SpineModule items of the referenced Spine packages." />
			<_SpineModulesLine Include="// &lt;/auto-generated&gt;" />
			<_SpineModulesLine Include="#pragma warning disable CA2255" />
			<_SpineModulesLine Include="namespace Plugin.Maui.Spine.Generated" />
			<_SpineModulesLine Include="{" />
			<_SpineModulesLine Include="$(_SpineIndent)internal static class SpineModuleRegistrations" />
			<_SpineModulesLine Include="$(_SpineIndent){" />
			<_SpineModulesLine Include="$(_SpineIndent)$(_SpineIndent)[global::System.Runtime.CompilerServices.ModuleInitializer]" />
			<_SpineModulesLine Include="$(_SpineIndent)$(_SpineIndent)internal static void Register()" />
			<_SpineModulesLine Include="$(_SpineIndent)$(_SpineIndent){" />
			<_SpineModulesLine Include="@(_SpineModuleRegister->'$(_SpineIndent)$(_SpineIndent)$(_SpineIndent)global::Plugin.Maui.Spine.Extensions.SpineModules.Add(static builder => global::%(Identity)(builder))%3B')" />
			<_SpineModulesLine Include="$(_SpineIndent)$(_SpineIndent)}" />
			<_SpineModulesLine Include="$(_SpineIndent)}" />
			<_SpineModulesLine Include="}" />
		</ItemGroup>

		<WriteLinesToFile Condition="'@(_SpineModuleRegister)' != ''"
						  File="$(_SpineModulesFile)"
						  Lines="@(_SpineModulesLine)"
						  Overwrite="true"
						  WriteOnlyWhenDifferent="true" />

		<ItemGroup Condition="'@(_SpineModuleRegister)' != ''">
			<Compile Include="$(_SpineModulesFile)" />
			<FileWrites Include="$(_SpineModulesFile)" />
		</ItemGroup>
	</Target>

	<!--
		Shortcut icons. The home screen draws a shortcut's icon, not the app, so it has to be an image in
		the app: iOS reads it from the bundle, Android from the drawables. Each name an app declares

		  <SpineShortcutIcon Include="qrcode" />

		is looked up among the app's own SVGs (EmbeddedResource and MauiImage), then among the
		SpineShortcutIconSource items the Plugin.Maui.Spine.Svg.Icons package declares, ignoring case,
		with dots and dashes read as underscores (figure.run finds figure_run.svg). The first match
		becomes a MauiImage named spine_shortcut_<key>, which Resizetizer renders for each platform, and
		options.Shortcuts' Add(..., icon: "qrcode") names that image. The key must stay the same as
		ShortcutIcons.Key in Core/ShortcutIcons.cs.
	-->
	<Target Name="_SpineAddShortcutIcons" BeforeTargets="ResizetizeCollectItems" Condition="'@(SpineShortcutIcon)' != ''">

		<ItemGroup>
			<_SpineShortcutIconWanted Include="@(SpineShortcutIcon)"
				Key="$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '(?i)\.svg$', '').ToLowerInvariant()), '[^a-z0-9]', '_'))" />

			<!-- The app's own first, so an app can replace an icon of the set. -->
			<_SpineShortcutIconCandidate Include="@(EmbeddedResource)" Condition="'%(Extension)' == '.svg'" />
			<_SpineShortcutIconCandidate Include="@(MauiImage)" Condition="'%(Extension)' == '.svg'" />
			<_SpineShortcutIconCandidate Include="@(SpineShortcutIconSource)" />
			<_SpineShortcutIconCandidate>
				<Key>$([System.Text.RegularExpressions.Regex]::Replace($([System.String]::Copy('%(Filename)').ToLowerInvariant()), '[^a-z0-9]', '_'))</Key>
				<Source>%(FullPath)</Source>
			</_SpineShortcutIconCandidate>
		</ItemGroup>

		<PropertyGroup>
			<_SpineShortcutIconKeys>;@(_SpineShortcutIconWanted->'%(Key)');</_SpineShortcutIconKeys>
		</PropertyGroup>

		<ItemGroup>
			<_SpineShortcutIconMatch Include="@(_SpineShortcutIconCandidate->'%(Key)')" Condition="$(_SpineShortcutIconKeys.Contains(';%(Key);'))" />
		</ItemGroup>

		<!-- One per key, the first found. -->
		<RemoveDuplicates Inputs="@(_SpineShortcutIconMatch)">
			<Output TaskParameter="Filtered" ItemName="_SpineShortcutIconFound" />
		</RemoveDuplicates>

		<PropertyGroup>
			<_SpineShortcutIconFoundKeys>;@(_SpineShortcutIconFound);</_SpineShortcutIconFoundKeys>
		</PropertyGroup>

		<Warning Condition="!$(_SpineShortcutIconFoundKeys.Contains(';%(_SpineShortcutIconWanted.Key);'))"
				 Text="SpineShortcutIcon &quot;%(_SpineShortcutIconWanted.Identity)&quot;: no %(_SpineShortcutIconWanted.Key).svg among the app's SVGs or in Plugin.Maui.Spine.Svg.Icons. The shortcut shows without it: iOS falls back to the SF Symbol of that name, if there is one." />

		<ItemGroup>
			<MauiImage Include="%(_SpineShortcutIconFound.Source)" Link="spine_shortcut_%(_SpineShortcutIconFound.Identity).svg" BaseSize="35,35" />
		</ItemGroup>
	</Target>

</Project>
